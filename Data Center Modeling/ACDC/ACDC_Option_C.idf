    Hourly;                  !- Reporting Frequency

Output:EnvironmentalImpactFactors,
    Daily;                   !- Reporting Frequency

Output:EnvironmentalImpactFactors,
    Monthly;                 !- Reporting Frequency

Output:EnvironmentalImpactFactors,
    RunPeriod;               !- Reporting Frequency


!-   ===========  ALL OBJECTS IN CLASS: ENVIRONMENTALIMPACTFACTORS ===========

EnvironmentalImpactFactors,
    0.3,                     !- District Heating Water Efficiency
    3.0,                     !- District Cooling COP {W/W}
    0.25,                    !- District Heating Steam Conversion Efficiency
    80.7272,                 !- Total Carbon Equivalent Emission Factor From N2O {kg/kg}
    6.2727,                  !- Total Carbon Equivalent Emission Factor From CH4 {kg/kg}
    0.2727;                  !- Total Carbon Equivalent Emission Factor From CO2 {kg/kg}


!-   ===========  ALL OBJECTS IN CLASS: OUTPUT:DIAGNOSTICS ===========

Output:Diagnostics,
    DisplayAdvancedReportVariables;  !- Key 1


!-   ===========  ALL OBJECTS IN CLASS: PYTHONPLUGIN:SEARCHPATHS ===========

PythonPlugin:SearchPaths,
    MyWork,                  !- Name
    Yes,                     !- Add Current Working Directory to Search Path
    Yes,                     !- Add Input File Directory to Search Path
    Yes,                     !- Add epin Environment Variable to Search Path
    C:\Users\user\Desktop\final_set;  !- Search Path 1


!-   ===========  ALL OBJECTS IN CLASS: PYTHONPLUGIN:INSTANCE ===========

PythonPlugin:Instance,
    Condenser OnOff Management,  !- Name
    Yes,                     !- Run During Warmup Days
    PythonPluginPlatnLoopOverrideControl,  !- Python Module Name
    TowerControl;            !- Plugin Class Name


