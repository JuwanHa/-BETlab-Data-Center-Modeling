    PythonPlugin m_water,    !- Name
    CoolingtowerWaterFlow,   !- Python Plugin Variable Name
    Averaged,                !- Type of Data in Variable
    SystemTimestep,          !- Update Frequency
    kg/s;                    !- Units

PythonPlugin:OutputVariable,
    PythonPlugin Coolingtower Fan Flow Override On,  !- Name
    FanFlowOverrideReport,   !- Python Plugin Variable Name
    Averaged,                !- Type of Data in Variable
    SystemTimestep;          !- Update Frequency

PythonPlugin:OutputVariable,
    PythonPlugin CT_in,      !- Name
    CoolingtowerInTemperature,  !- Python Plugin Variable Name
    Averaged,                !- Type of Data in Variable
    SystemTimestep,          !- Update Frequency
    C;                       !- Units

