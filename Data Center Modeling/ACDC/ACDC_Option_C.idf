!-   ===========  ALL OBJECTS IN CLASS: CONSTRUCTION ===========

Construction,
    LinearBridgingConstruction,  !- Name
    LinearBridgingLayer;     !- Outside Layer

Construction,
    IRTSurface,              !- Name
    IRTMaterial;             !- Outside Layer

! floor
Construction,
    floor,                   !- Name
    External Rendering_.025, !- Outside Layer
    MW Stone Wool (rolls)_.1261,  !- Layer 2
    Timber Flooring_.005;    !- Layer 3

! <Previous reversed>
Construction,
    floor_Rev,               !- Name
    Timber Flooring_.005,    !- Outside Layer
    MW Stone Wool (rolls)_.1261,  !- Layer 2
    External Rendering_.025; !- Layer 3

! roof
Construction,
    roof,                    !- Name
    Asphalt 1_.01,           !- Outside Layer
    MW Glass Wool (rolls)_.2512,  !- Layer 2
    3_RVAL_3,                !- Layer 3
    Plasterboard_.013;       !- Layer 4

! <Previous reversed>
Construction,
    roof_Rev,                !- Name
    Plasterboard_.013,       !- Outside Layer
    4_RVAL_2,                !- Layer 2
    MW Glass Wool (rolls)_.2512,  !- Layer 3
    Asphalt 1_.01;           !- Layer 4

! Project partition
Construction,
    Project partition,       !- Name
    Gypsum Plasterboard_.025,!- Outside Layer
    5_RVAL_2,                !- Layer 2
    Gypsum Plasterboard_.025;!- Layer 3

! <Previous reversed>
Construction,
    Project partition_Rev,   !- Name
    Gypsum Plasterboard_.025,!- Outside Layer
    6_RVAL_2,                !- Layer 2
    Gypsum Plasterboard_.025;!- Layer 3

Construction,
    Project roof glazing - 1001,  !- Name
    2,                       !- Outside Layer
    1001,                    !- Layer 2
    2,                       !- Layer 3
    1001,                    !- Layer 4
    2;                       !- Layer 5

Construction,
    Project external glazing - 1002,  !- Name
    38,                      !- Outside Layer
    1002,                    !- Layer 2
    2;                       !- Layer 3


